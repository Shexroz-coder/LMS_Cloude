# ══════════════════════════════════════════════════════════
# Robotic Edu LMS — Environment Variables
# Bu faylni .env nomiga nusxalang va qiymatlarni o'zgartiring:
#   cp .env.example .env && nano .env
# ══════════════════════════════════════════════════════════

# ─── Database ────────────────────────────────────────────
POSTGRES_DB=lms_robotic
POSTGRES_USER=lms_user
POSTGRES_PASSWORD=change_this_strong_password

# ─── Redis ───────────────────────────────────────────────
REDIS_PASSWORD=change_this_redis_password

# ─── JWT Secrets (MUHIM: uzun, xavfsiz stringlar!) ──────
JWT_SECRET=minimum_32_chars_random_secret_here_changeme
JWT_REFRESH_SECRET=another_minimum_32_chars_secret_here_changeme
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d

# ─── App Settings ───────────────────────────────────────
FRONTEND_URL=https://your-domain.uz
VITE_API_BASE_URL=/api/v1

# ─── Telegram Bot ───────────────────────────────────────
TELEGRAM_BOT_TOKEN=8513268264:AAETiGq1Z2Zd6tXmgo7P0n5lR3GQIq3fl98
TELEGRAM_ADMIN_ID=7537442767

# ─── AI Agent API (MCP server) ──────────────────────────
# Uzun, tasodifiy string. MCP server shu kalit bilan ulanadi.
AGENT_API_KEY=change-this-to-a-long-random-secret

# ─── OpenAI (Voice AI Agent) ────────────────────────────
# Whisper (ovoz→matn) + GPT-4o (mantiq). platform.openai.com dan olinadi.
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o

# ─── Ovoz tanish (STT) provayderi ───────────────────────
# whisper (OpenAI) yoki gemini (Google — o'zbekchani yaxshiroq tushunadi)
STT_PROVIDER=whisper
# Gemini uchun (STT_PROVIDER=gemini bo'lsa): ai.google.dev dan bepul kalit
GEMINI_API_KEY=
GEMINI_STT_MODEL=gemini-2.0-flash
